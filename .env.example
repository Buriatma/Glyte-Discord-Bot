DISCORD_TOKEN=PASTE_TOKEN_HERE-never-commit-this-file
# Atlas example (fill in your cluster host):
# MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/discord_bot?retryWrites=true&w=majority
# Local docker example:
# MONGO_URI=mongodb://bot:changeme@mongo:27017/discord_bot?authSource=admin
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/discord_bot?retryWrites=true&w=majority
MONGO_DB=discord_bot
XP_PER_MSG=10
MSG_COOLDOWN_S=5
FLUSH_EVERY_S=30
SUMMARY_CHANNEL_ID=
SUMMARY_TIME=23:00
SUMMARY_TZ=UTC
STANDUP_CHANNEL_ID=
STANDUP_TIME=10:00
DASHBOARD_PORT=8080
DASHBOARD_PUBLIC_URL=http://localhost:8080

# Optional Privileged Intents (must be enabled in Discord Dev Portal -> Bot)
INTENTS_MEMBERS=false
INTENTS_MESSAGE_CONTENT=false

